{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nonprofit-explorer-mcp-server",
  "version": "0.1.8",
  "description": "Search and explore 1.8M+ US nonprofits, fetch Form 990 financials, and access IRS filing history via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/nonprofit-explorer-mcp-server#readme",
  "repository": "https://github.com/cyanheads/nonprofit-explorer-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "nonprofit",
    "propublica",
    "irs",
    "form-990",
    "tax-exempt"
  ],
  "mcpServers": {
    "nonprofit-explorer-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/nonprofit-explorer-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
